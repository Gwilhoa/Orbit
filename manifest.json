{
  "manifest_version": 3,
  "name": "Orbit",
  "version": "1.0.1",
  "description": "Track your logtime, know exactly when to leave, and instantly spot a free seat with our redesigned interactive cluster map.",
  "browser_specific_settings": {
    "gecko": {
      "id": "@Orbit",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://profile.intra.42.fr/*"],
      "js": ["mainPage.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://meta.intra.42.fr/clusters*"],
      "js": ["clusterPage.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/5_bus.svg",
        "assets/86_bus.svg",
        "assets/transit.png"
      ],
      "matches": ["https://profile.intra.42.fr/*"]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.bitume2000.fr/"
  ]
}