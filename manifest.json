{
  "manifest_version": 3,
  "name": "Orbit",
  "version": "1.3.0",
  "description": "Track your logtime and know exactly when to leave with integrated transit departures.",
  "browser_specific_settings": {
    "gecko": {
      "id": "@Orbit",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://profile.intra.42.fr/*"
      ],
      "js": [
        "mainPage.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/86_bus.svg",
        "assets/105_bus.svg",
        "assets/132_bus.svg",
        "assets/216_bus.svg",
        "assets/transit.png"
      ],
      "matches": [
        "https://profile.intra.42.fr/*"
      ]
    }
  ],
  "host_permissions": [
    "https://transit.gchatain.fr/*"
  ]
}