{
  "name": "42companion",
  "version": "1.0.0",
  "description": "Essential companion tools for 42 students including logtime tracking and bus schedules.",
  "main": "main.js",
  "scripts": {
    "build": "echo 'No build process needed for manifest v3'",
    "dev": "echo 'Load extension in Chrome developer mode'",
    "lint": "echo 'main.js:270 - No linter configured'",
    "test": "echo 'No tests configured'",
    "zip": "zip -r timesync42.zip . -x '*.git*' 'node_modules/*' '*.zip'",
    "xpi": "jar cf 42companion.xpi manifest.json main.js assets/",
    "sign": "web-ext sign --api-key=$AMO_API_KEY --api-secret=$AMO_API_SECRET"
  },
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "42",
    "logtime",
    "bus-schedule",
    "student-tools"
  ],
  "author": "Guilheim C",
  "license": "MIT",
  "devDependencies": {
    "web-ext": "^9.2.0"
  }
}
